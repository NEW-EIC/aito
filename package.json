{
  "name": "aito",
  "version": "0.1.0",
  "private": true,
  "description": "AITO · Alto monorepo — Phase 1 trans-Pacific subscription platform.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:domain": "pnpm --filter @aito/domain test",
    "db:up": "pnpm --filter @aito/database db:up",
    "db:migrate": "pnpm --filter @aito/database prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @aito/database prisma:migrate:deploy",
    "db:studio": "pnpm --filter @aito/database prisma:studio",
    "db:seed": "pnpm --filter @aito/database prisma:seed",
    "web:dev": "pnpm --filter @aito/web dev",
    "web:build": "pnpm --filter @aito/web build",
    "vercel-build": "pnpm --filter @aito/database prisma:generate && pnpm db:migrate:deploy && pnpm --filter @aito/web build",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.6.3",
    "prettier": "3.4.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
