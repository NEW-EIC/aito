# ─── App ───────────────────────────────────────────────────────────────
# Public URL used to build absolute links inside emails (magic links etc.).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Session ───────────────────────────────────────────────────────────
# Reserved for a future signed-cookie layer on top of opaque session IDs.
# Not used by the current implementation. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ─── Email (Resend) ────────────────────────────────────────────────────
# Get an API key at https://resend.com — free tier is 100 emails/day.
# Leave RESEND_API_KEY empty to log emails to the dev console instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@aito-alto.com

# ─── Auth — toggles ────────────────────────────────────────────────────
# Set to "1" to skip the HaveIBeenPwned check (CI, offline development).
AITO_DISABLE_HIBP=

# ─── OAuth (Milestone 2) — comment back in when wired ──────────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# APPLE_OAUTH_CLIENT_ID=
# APPLE_OAUTH_TEAM_ID=
# APPLE_OAUTH_KEY_ID=
# APPLE_OAUTH_PRIVATE_KEY=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ─── Rate limit (Milestone 5) — switch in Redis for multi-region ───────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Stripe (Milestone — Subscriptions) ────────────────────────────────
# Keys come from https://dashboard.stripe.com/test/apikeys — keep test mode
# until invoice/checkout flows are signed off. Webhook secret comes from
# either `stripe listen` (local dev) or the Dashboard → Webhooks endpoint.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Price IDs from Stripe Dashboard → Products. One product (Premium / Pro) per
# tier with two recurring prices (month, year). Server resolves tier+interval
# to a price id — clients never send price ids directly.
STRIPE_PRICE_PREMIUM_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_PREMIUM_YEARLY=price_REPLACE_ME
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_PRO_YEARLY=price_REPLACE_ME
