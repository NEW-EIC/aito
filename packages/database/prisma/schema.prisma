// ============================================================================
//  AITO / Alto · Phase 1 — Prisma schema (Postgres)
//  -----------------------------------------------------------------------
//  Source of truth for all business entities the platform persists. Tier 0
//  (quant strategy / risk engine internals) lives in a separate, CTO-only
//  service and is NOT modeled here — only the platform shell is.
//
//  Conventions
//   - Snake_case columns (Postgres native), camelCase Prisma fields.
//   - All timestamps are `timestamptz`; never `timestamp`.
//   - Money is stored as integer cents (`*_cents`) + a `currency` ISO code.
//   - Soft deletes via `deleted_at` on user-visible content.
//   - All FKs are explicitly named and indexed.
//   - JSONB for flexible payloads (event bodies, feature flags, evidence).
//   - Native Postgres enums for state machines and tier keys.
//
//  Adjusted for Phase 1 v1.0 constraints (May 2026):
//   - US-only build. No mainland-China hosting or compliance entities.
//   - No WeChat mini-program tables.
//   - Stripe is the only Phase 1 payment provider; alipay/wechat_pay enum
//     values are reserved for Phase 2+ to avoid a destructive enum migration.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // `native` covers the dev box (Darwin / Linux). `rhel-openssl-3.0.x` is
  // what Vercel's Node 20 serverless runtime needs — without this, Next's
  // bundler can't find the query engine binary at request time and every
  // DB call throws PrismaClientInitializationError.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

// ============================================================================
//  Identity / Auth
// ============================================================================

/// A platform end-user. Authentication is delegated to an IdP (Logto / Clerk
/// / OAuth providers); we never store passwords. The `auth_provider` +
/// `auth_provider_user_id` pair maps our internal id to the IdP's id.
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // citext = case-insensitive text; prevents "Foo@x.com" / "foo@x.com" duplicates
  email           String    @unique @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz()
  phone           String?
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz()

  displayName   String?     @map("display_name")
  avatarAssetId String?     @map("avatar_asset_id") @db.Uuid
  avatar        MediaAsset? @relation("UserAvatar", fields: [avatarAssetId], references: [id])

  preferredLocale Locale  @default(en) @map("preferred_locale")
  timezone        String  @default("America/New_York")
  countryCode     String? @map("country_code") // ISO-3166-1 alpha-2

  // External identity provider. `internal` = email/password handled by us
  // (UserCredential row). OAuth values map to ExternalIdentity rows.
  authProvider       AuthProvider @default(internal) @map("auth_provider")
  authProviderUserId String?      @map("auth_provider_user_id")

  // Marketing
  marketingOptInAt DateTime? @map("marketing_opt_in_at") @db.Timestamptz()

  // Stripe customer linkage. One Stripe Customer per User, lazily created on
  // first checkout. Webhook handlers look users up by this id.
  stripeCustomerId String? @unique @map("stripe_customer_id")

  // Lifecycle
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz()
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz()

  // Relations
  sessions                Session[]
  externalIdentities      ExternalIdentity[]
  subscriptions           Subscription[]
  paymentMethods          PaymentMethod[]
  payments                Payment[]
  invoices                Invoice[]
  kycVerifications        KycVerification[]
  imMemberships           ImMembership[]
  liveAttendances         LiveAttendance[]
  newsletterSubscriptions NewsletterSubscription[]
  ownedReferralCodes      ReferralCode[]           @relation("ReferralCodeOwner")
  attributionsAsReferer   ReferralAttribution[]    @relation("Referer")
  attributionsAsReferee   ReferralAttribution[]    @relation("Referee")
  auditLogEntries         AuditLogEntry[]

  // RBAC / staff
  staffProfile StaffProfile?
  userRoles    UserRole[]    @relation("UserRoleHolder")
  grantedRoles UserRole[]    @relation("UserRoleGrantedBy")

  // Behavior + bookmarks
  articleViews          ArticleView[]
  articleReadProgress   ArticleReadProgress[]
  podcastListenEvents   PodcastListenEvent[]
  podcastListenProgress PodcastListenProgress[]
  contentBookmarks      ContentBookmark[]
  contentReactions      ContentReaction[]
  contentShares         ContentShare[]
  searchQueries         SearchQueryLog[]

  // Content authorship audit
  articleRevisionsEdited ArticleTranslationRevision[]

  // Legal acceptance
  legalAcceptances UserLegalAcceptance[]

  // Media assets uploaded by this user
  uploadedAssets MediaAsset[] @relation("MediaAssetUploader")

  // Self-hosted auth (M1)
  credential UserCredential?
  authTokens AuthToken[]

  // P0+P1 additions
  notificationPreferences     NotificationPreference[]
  deviceTokens                DeviceToken[]
  mfaFactors                  UserMfaFactor[]
  apiTokensCreated            ApiToken[]               @relation("ApiTokenCreator")
  couponRedemptions           CouponRedemption[]
  accountCredit               AccountCredit?
  accountCreditEntriesGranted AccountCreditEntry[]     @relation("CreditEntryGranter")
  payoutsReceived             Payout[]                 @relation("PayoutRecipient")
  giftsPurchased              GiftSubscription[]       @relation("GiftPurchaser")
  giftsReceived               GiftSubscription[]       @relation("GiftRecipient")
  liveRegistrations           LiveRegistration[]
  reviewsPerformed            ArticleReview[]          @relation("ArticleReviewer")
  erratumsPosted              ArticleErratum[]         @relation("ErratumPostedBy")
  platformSettingsUpdated     PlatformSetting[]        @relation("SettingUpdatedBy")

  @@unique([authProvider, authProviderUserId])
  @@index([deletedAt])
  @@map("users")
}

enum AuthProvider {
  /// Email + password handled by our own server (UserCredential).
  internal
  /// Legacy values — kept for enum compat, not referenced in code.
  logto
  clerk
  /// OAuth identity providers (also recorded in ExternalIdentity).
  google
  apple
  github
  email_otp

  @@map("auth_provider")
}

/// Email/password credential. One row per User who signed up with internal
/// auth. OAuth-only users do NOT have a row here.
model UserCredential {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// argon2id hash of the password.
  passwordHash String @map("password_hash")

  /// Force password change on next login (admin reset).
  mustChange Boolean @default(false) @map("must_change")

  /// Last successful login. Stale rows = candidates for re-verification.
  lastVerifiedAt DateTime @default(now()) @map("last_verified_at") @db.Timestamptz()

  /// Lockout state — after N failed attempts within M minutes. We track the
  /// window's start so attempts older than the window roll off and don't
  /// stack forever.
  failedAttempts        Int       @default(0) @map("failed_attempts")
  failedWindowStartedAt DateTime? @map("failed_window_started_at") @db.Timestamptz()
  lockedUntil           DateTime? @map("locked_until") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("user_credentials")
}

/// Single-use tokens for verification flows: email verification, magic
/// links, password reset, OTPs, MFA step-up. Never store the plaintext
/// token — only sha256.
model AuthToken {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// What kind of token. Determines validity window + delivery channel.
  purpose AuthTokenPurpose

  /// sha256 of the opaque token sent to user. Never store plaintext.
  tokenHash String @unique @map("token_hash")

  /// FK — null for unauthenticated flows (signup email verification before
  /// the User row exists). For password reset, points at the user.
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Identity claim we're verifying. For email verification = the new email.
  /// For OTP = phone number. For password reset = email.
  identifier String @db.Citext

  /// For OTP / OTP-link: 6-8 digit code (also hashed). For magic link: null.
  codeHash String? @map("code_hash")

  /// Anti-replay: stamped on first successful redemption.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz()

  /// Anti-abuse counters.
  attempts Int @default(0)

  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId, purpose])
  @@index([identifier, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

enum AuthTokenPurpose {
  email_verification
  password_reset
  magic_link
  email_otp
  phone_otp
  mfa_challenge

  @@map("auth_token_purpose")
}

/// Server-validated session. If you adopt a stateless JWT-only auth,
/// you can leave this empty; it's here to support session revocation.
model Session {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String  @unique @map("token_hash")
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Maps a user to their identity in a downstream system (Discourse, Stream
/// Chat, Beehiiv). One row per (user, provider).
model ExternalIdentity {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider       ExternalProvider
  externalUserId String           @map("external_user_id")
  metadata       Json?            @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([provider, externalUserId])
  @@unique([userId, provider])
  @@map("external_identities")
}

enum ExternalProvider {
  discourse
  stream_chat
  beehiiv
  resend

  @@map("external_provider")
}

// ============================================================================
//  Locale / Shared
// ============================================================================

enum Locale {
  en
  zh_CN @map("zh-CN")
  zh_TW @map("zh-TW")
  ja
  ko
  fr

  @@map("locale")
}

// ============================================================================
//  Subscription / Billing
// ============================================================================

/// Plan = Reader / Premium / Pro Desk. Stripe price/product IDs are stored
/// per-billing-interval so we can drive Checkout from this single row.
model Plan {
  id  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key PlanKey @unique

  name    String
  summary String?

  // Pricing in smallest currency unit (USD cents)
  monthlyPriceCents Int?   @map("monthly_price_cents")
  annualPriceCents  Int?   @map("annual_price_cents")
  currency          String @default("USD")

  // Stripe linkage (one product, two prices for monthly / annual)
  stripeProductId      String? @unique @map("stripe_product_id")
  stripeMonthlyPriceId String? @unique @map("stripe_monthly_price_id")
  stripeAnnualPriceId  String? @unique @map("stripe_annual_price_id")

  /// Feature matrix. Read by the paywall rule engine.
  /// Example: { liveReplay: true, liveQA: false, modelFiles: false }
  features Json @db.JsonB

  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  subscriptions Subscription[]

  @@map("plans")
}

enum PlanKey {
  free
  premium
  pro

  @@map("plan_key")
}

/// One row per user × subscription period. State follows the state machine
/// in `lib/domain/subscription.ts` of the prototype repo.
///
/// NOTE on uniqueness: a user may have at most ONE subscription in
/// (trial | active | past_due | grace_period). We enforce this at the
/// application layer because Postgres partial unique indexes aren't first-
/// class in Prisma; see migrations/{ts}_partial_unique_active_sub.sql for
/// the DB-level guarantee.
model Subscription {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  planId String @map("plan_id") @db.Uuid
  plan   Plan   @relation(fields: [planId], references: [id])

  state           SubscriptionState
  billingInterval BillingInterval   @map("billing_interval")

  // Trial window
  trialStartedAt DateTime? @map("trial_started_at") @db.Timestamptz()
  trialEndsAt    DateTime? @map("trial_ends_at") @db.Timestamptz()

  // Current paid period
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz()
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz()

  // Grace period after a failed payment (default 7 days)
  graceEndsAt DateTime? @map("grace_ends_at") @db.Timestamptz()

  // Cancellation
  canceledAt           DateTime?           @map("canceled_at") @db.Timestamptz()
  cancelAtPeriodEnd    Boolean             @default(false) @map("cancel_at_period_end")
  cancellationReason   CancellationReason? @map("cancellation_reason")
  cancellationFeedback String?             @map("cancellation_feedback") @db.Text

  // Stripe linkage
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  stripeCustomerId     String? @map("stripe_customer_id")

  // High-water mark for out-of-order Stripe webhook delivery. Set to the
  // `event.created` (UTC) of the most recent Stripe event we acted on for
  // this subscription. Events with an older timestamp are dropped.
  lastStripeEventAt    DateTime? @map("last_stripe_event_at") @db.Timestamptz()

  // Where the user signed up (homepage / article-cta / referral / ...)
  signupSource   String? @map("signup_source")
  // Referral attribution (denormalized for fast reads)
  referralCodeId String? @map("referral_code_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  events            SubscriptionEvent[]
  invoices          Invoice[]
  couponRedemptions CouponRedemption[]

  @@index([userId])
  @@index([state])
  @@index([currentPeriodEnd])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

enum SubscriptionState {
  trial
  active
  past_due
  grace_period
  canceled
  expired

  @@map("subscription_state")
}

enum BillingInterval {
  monthly
  annual

  @@map("billing_interval")
}

/// Append-only log of every subscription state transition. Doubles as a
/// transactional outbox: downstream consumers (Resend "trial started"
/// email, Stream Chat group add, Discourse SSO) read unprocessed rows and
/// stamp `processed_at` when done. Idempotent on `external_event_id`.
model SubscriptionEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  eventType String             @map("event_type")
  fromState SubscriptionState? @map("from_state")
  toState   SubscriptionState  @map("to_state")

  externalEventId String? @unique @map("external_event_id")
  payload         Json    @db.JsonB

  processedAt DateTime? @map("processed_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([subscriptionId])
  @@index([processedAt])
  @@map("subscription_events")
}

/// A saved card / wallet. Mirrored from Stripe; never holds raw card data.
model PaymentMethod {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  provider   PaymentProvider
  externalId String          @map("external_id") // Stripe pm_xxx

  brand    String? // visa, mastercard, amex, ...
  last4    String? @db.VarChar(4)
  expMonth Int?    @map("exp_month")
  expYear  Int?    @map("exp_year")

  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  removedAt DateTime? @map("removed_at") @db.Timestamptz()

  @@unique([provider, externalId])
  @@index([userId])
  @@map("payment_methods")
}

enum PaymentProvider {
  stripe
  alipay // reserved for Phase 2+
  wechat_pay // reserved for Phase 2+
  manual // comped / invoiced

  @@map("payment_provider")
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation(fields: [userId], references: [id])
  subscriptionId String?       @map("subscription_id") @db.Uuid
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  status InvoiceStatus

  amountDueCents  Int    @map("amount_due_cents")
  amountPaidCents Int    @default(0) @map("amount_paid_cents")
  taxCents        Int    @default(0) @map("tax_cents")
  currency        String @default("USD")

  provider          PaymentProvider @default(stripe)
  externalInvoiceId String?         @unique @map("external_invoice_id")

  issuedAt DateTime  @map("issued_at") @db.Timestamptz()
  dueAt    DateTime? @map("due_at") @db.Timestamptz()
  paidAt   DateTime? @map("paid_at") @db.Timestamptz()

  hostedInvoiceUrl String? @map("hosted_invoice_url")
  pdfUrl           String? @map("pdf_url")

  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

enum InvoiceStatus {
  draft
  open
  paid
  void
  uncollectible

  @@map("invoice_status")
}

model Payment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  invoiceId String?  @map("invoice_id") @db.Uuid
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  status PaymentStatus

  amountCents Int    @map("amount_cents")
  currency    String @default("USD")

  provider         PaymentProvider
  externalId       String          @map("external_id") // Stripe pi_xxx
  externalChargeId String?         @map("external_charge_id") // Stripe ch_xxx

  // Idempotency for webhook handlers
  externalEventId String? @unique @map("external_event_id")

  failureCode    String? @map("failure_code")
  failureMessage String? @map("failure_message")

  refundedAmountCents Int @default(0) @map("refunded_amount_cents")

  refunds Refund[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([provider, externalId])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded

  @@map("payment_status")
}

model Refund {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId String  @map("payment_id") @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id])

  amountCents Int     @map("amount_cents")
  reason      String?

  externalId      String  @map("external_id") // Stripe re_xxx
  externalEventId String? @unique @map("external_event_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([externalId])
  @@index([paymentId])
  @@map("refunds")
}

// ============================================================================
//  Content (Articles / Newsletters / Podcasts)
// ============================================================================

model Author {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique

  name  String
  title String?
  bio   String? @db.Text

  avatarAssetId String?     @map("avatar_asset_id") @db.Uuid
  avatar        MediaAsset? @relation("AuthorAvatar", fields: [avatarAssetId], references: [id])

  twitterHandle String? @map("twitter_handle")
  linkedinUrl   String? @map("linkedin_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  articleAuthors      ArticleAuthor[]
  liveStreamHosts     LiveStreamHost[]
  positionDisclosures EditorialPositionDisclosure[]

  @@map("authors")
}

/// Generic content unit. `kind` distinguishes podcast / newsletter / blog;
/// each kind may have additional metadata in a 1:1 child table
/// (`PodcastEpisode`, `NewsletterCampaign`).
model Article {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique

  kind   ArticleKind
  status ArticleStatus

  /// What plan tier is needed to read the FULL body. The free preview is
  /// always rendered; the paywall component cuts off based on this.
  requiredTier PlanKey @default(free) @map("required_tier")

  /// Compliance classification for financial content.
  /// `specific_recommendation` triggers mandatory legal review + extra disclaimer.
  complianceClass ComplianceClass @default(market_commentary) @map("compliance_class")

  publishedAt  DateTime? @map("published_at") @db.Timestamptz()
  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz()

  heroImageAssetId String?     @map("hero_image_asset_id") @db.Uuid
  heroImage        MediaAsset? @relation("ArticleHeroImage", fields: [heroImageAssetId], references: [id])

  categoryId String?   @map("category_id") @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id])

  // 1:1 children for kind-specific extension
  newsletterCampaign NewsletterCampaign?
  podcastEpisode     PodcastEpisode?

  // M:N
  authors      ArticleAuthor[]
  tags         ArticleTag[]
  translations ArticleTranslation[]

  // Behavior tracking
  views        ArticleView[]
  readProgress ArticleReadProgress[]

  // Compliance workflow
  reviews             ArticleReview[]
  positionDisclosures EditorialPositionDisclosure[]
  errata              ArticleErratum[]
  sources             ArticleSource[]
  dailyMetrics        ArticleDailyMetric[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([status, publishedAt])
  @@index([kind, requiredTier])
  @@index([categoryId])
  @@index([complianceClass])
  @@map("articles")
}

enum ArticleKind {
  newsletter
  podcast
  blog

  @@map("article_kind")
}

enum ArticleStatus {
  draft
  in_review // editor handed off to reviewer
  legal_review // flagged as specific_recommendation, needs legal sign-off
  scheduled
  published
  archived

  @@map("article_status")
}

/// Localized article body. Each (article, locale) pair holds title +
/// MDX body + SEO fields. We do NOT auto-translate — translations are
/// human-edited rows in this table.
model ArticleTranslation {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId String  @map("article_id") @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  locale Locale

  title    String
  subtitle String?
  bodyMdx  String  @map("body_mdx") @db.Text
  excerpt  String  @db.Text

  // SEO
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")

  // Monotonic version number, bumped on every save
  currentVersion Int @default(1) @map("current_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  revisions ArticleTranslationRevision[]

  @@unique([articleId, locale])
  @@map("article_translations")
}

model ArticleAuthor {
  articleId String  @map("article_id") @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String  @map("author_id") @db.Uuid
  author    Author  @relation(fields: [authorId], references: [id])

  role      String @default("author") // author / editor / host / guest
  sortOrder Int    @default(0) @map("sort_order")

  @@id([articleId, authorId])
  @@map("article_authors")
}

model Category {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique
  name String

  parentId String?    @map("parent_id") @db.Uuid
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  articles Article[]

  @@map("categories")
}

model Tag {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique
  name String

  articles ArticleTag[]

  @@map("tags")
}

model ArticleTag {
  articleId String  @map("article_id") @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     String  @map("tag_id") @db.Uuid
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
  @@map("article_tags")
}

/// 1:1 extension on Article when kind = podcast.
model PodcastEpisode {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId String  @unique @map("article_id") @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  episodeNumber Int  @map("episode_number")
  seasonNumber  Int? @map("season_number")

  // Audio — canonical reference lives on MediaAsset.
  // durationSeconds is duplicated here for fast list queries; it MUST match
  // audioAsset.durationSeconds (enforced by app-layer save hook).
  audioAssetId    String     @map("audio_asset_id") @db.Uuid
  audioAsset      MediaAsset @relation("PodcastAudio", fields: [audioAssetId], references: [id])
  durationSeconds Int        @map("duration_seconds")

  // Transcript file (text/vtt/srt). Optional — not all episodes have one.
  transcriptAssetId String?     @map("transcript_asset_id") @db.Uuid
  transcriptAsset   MediaAsset? @relation("PodcastTranscript", fields: [transcriptAssetId], references: [id])

  // Distribution
  appleEpisodeId   String? @map("apple_episode_id")
  spotifyEpisodeId String? @map("spotify_episode_id")

  // Behavior
  listenEvents   PodcastListenEvent[]
  listenProgress PodcastListenProgress[]
  dailyMetrics   PodcastEpisodeDailyMetric[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("podcast_episodes")
}

// ============================================================================
//  Newsletter delivery (Resend / Beehiiv dual-send)
// ============================================================================

/// A single newsletter "blast". One Article → one NewsletterCampaign.
model NewsletterCampaign {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId String  @unique @map("article_id") @db.Uuid
  article   Article @relation(fields: [articleId], references: [id])

  status CampaignStatus

  /// Localized subject lines: { "en": "...", "zh-CN": "..." }
  subjectLines Json @map("subject_lines") @db.JsonB
  /// Localized preview text (the snippet shown in inbox lists).
  previewTexts Json @map("preview_texts") @db.JsonB

  // Targeting
  targetTier   PlanKey? @map("target_tier") // null = all subscribers
  targetLocale Locale?  @map("target_locale") // null = all locales

  // Provider routing
  provider           EmailProvider @default(resend)
  externalCampaignId String?       @map("external_campaign_id")

  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz()
  sentAt       DateTime? @map("sent_at") @db.Timestamptz()

  // Cached aggregates (refreshed by webhook handlers)
  recipientCount   Int @default(0) @map("recipient_count")
  deliveredCount   Int @default(0) @map("delivered_count")
  openCount        Int @default(0) @map("open_count")
  clickCount       Int @default(0) @map("click_count")
  unsubscribeCount Int @default(0) @map("unsubscribe_count")
  bounceCount      Int @default(0) @map("bounce_count")

  sends NewsletterSend[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status])
  @@map("newsletter_campaigns")
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  failed

  @@map("campaign_status")
}

enum EmailProvider {
  beehiiv
  resend
  postmark

  @@map("email_provider")
}

/// A subscriber to the email list (NOT the same as a paid Subscription).
/// A user with a paid plan typically also has a NewsletterSubscription —
/// they are joined via `userId` when known, but anonymous email-only
/// captures (homepage CTA) are also tracked here.
model NewsletterSubscription {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  email  String @unique @db.Citext
  locale Locale @default(en)

  status NewsletterSubscriptionStatus
  source String? // homepage / article-cta / referral

  // Beehiiv linkage during dual-send window (W17–W22)
  beehiivSubscriberId String? @map("beehiiv_subscriber_id")

  subscribedAt        DateTime           @default(now()) @map("subscribed_at") @db.Timestamptz()
  unsubscribedAt      DateTime?          @map("unsubscribed_at") @db.Timestamptz()
  unsubscribeReason   UnsubscribeReason? @map("unsubscribe_reason")
  unsubscribeFeedback String?            @map("unsubscribe_feedback") @db.Text

  sends NewsletterSend[]

  @@index([userId])
  @@index([status])
  @@map("newsletter_subscriptions")
}

enum NewsletterSubscriptionStatus {
  active
  unsubscribed
  bounced
  complained

  @@map("newsletter_subscription_status")
}

/// One row per (campaign, subscriber). Tracks the per-recipient send
/// lifecycle: queued → sent → delivered → opened → clicked.
model NewsletterSend {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId     String                 @map("campaign_id") @db.Uuid
  campaign       NewsletterCampaign     @relation(fields: [campaignId], references: [id])
  subscriptionId String                 @map("subscription_id") @db.Uuid
  subscription   NewsletterSubscription @relation(fields: [subscriptionId], references: [id])

  status SendStatus

  externalMessageId String? @map("external_message_id")

  sentAt         DateTime?   @map("sent_at") @db.Timestamptz()
  deliveredAt    DateTime?   @map("delivered_at") @db.Timestamptz()
  openedAt       DateTime?   @map("opened_at") @db.Timestamptz()
  firstClickedAt DateTime?   @map("first_clicked_at") @db.Timestamptz()
  bouncedAt      DateTime?   @map("bounced_at") @db.Timestamptz()
  bounceType     BounceType? @map("bounce_type")
  /// Raw provider code: SMTP code or Resend/SendGrid reason string.
  bounceCode     String?     @map("bounce_code")

  failureMessage String? @map("failure_message")

  linkClicks NewsletterLinkClick[]

  @@unique([campaignId, subscriptionId])
  @@index([status])
  @@map("newsletter_sends")
}

enum SendStatus {
  queued
  sent
  delivered
  bounced
  failed

  @@map("send_status")
}

// ============================================================================
//  Live streaming (Mux integration)
// ============================================================================

model LiveStream {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  title       String
  description String? @db.Text

  scheduledStartAt DateTime  @map("scheduled_start_at") @db.Timestamptz()
  scheduledEndAt   DateTime? @map("scheduled_end_at") @db.Timestamptz()
  actualStartAt    DateTime? @map("actual_start_at") @db.Timestamptz()
  actualEndAt      DateTime? @map("actual_end_at") @db.Timestamptz()

