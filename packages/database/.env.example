# Copy to .env (which is git-ignored) and fill in.

# ----- Database connection -----------------------------------------------
# Pick ONE of the three setups:
#
# Option A · Local Postgres via docker-compose (recommended for new dev)
DATABASE_URL="postgresql://aito:aito_dev_only@localhost:5432/aito_alto?schema=public"
#
# Option B · Postgres.app on macOS (no Docker)
# DATABASE_URL="postgresql://$USER@localhost:5432/aito_alto?schema=public"
#
# Option C · Neon Free tier (cloud, 0.5 GB, no credit card)
# Sign up at https://neon.tech and copy the connection string.
# DATABASE_URL="postgresql://aito:xxx@ep-foo-bar.us-east-1.aws.neon.tech/aito_alto?sslmode=require"

# ----- Direct (uncached) connection used by migrations only --------------
# Required when DATABASE_URL is a pgbouncer / pooled connection (Neon).
# For local Docker / Postgres.app, leave this equal to DATABASE_URL.
DIRECT_DATABASE_URL="${DATABASE_URL}"

# ----- App-layer crypto (placeholder for KYC PII encryption) -------------
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=""

# ----- Stripe (NOT needed for schema work — wired in W4-W5) --------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
